{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique ID from Firebase Auth" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "format": "uri", "description": "User's profile photo URL" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User's role for access control" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Poll": {
      "title": "Arena Poll",
      "description": "Represents a voting arena.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Arena title" },
        "description": { "type": "string", "description": "Arena description" },
        "startDate": { "type": "string", "format": "date-time", "description": "Arena start time" },
        "endDate": { "type": "string", "format": "date-time", "description": "Arena end time" },
        "status": { "type": "string", "enum": ["active", "ended"], "description": "Current status of the arena" },
        "createdBy": { "type": "string", "description": "UID of the creator" },
        "isPublished": { "type": "boolean", "description": "Whether the arena is visible to the public" },
        "participantImages": { "type": "array", "items": { "type": "string" }, "description": "List of participant image URLs" }
      },
      "required": ["title", "startDate", "endDate", "status", "createdBy", "isPublished", "participantImages"]
    },
    "Participant": {
      "title": "Arena Participant",
      "description": "A participant in a voting arena.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Participant name" },
        "imageUrl": { "type": "string", "format": "uri", "description": "Participant image URL" },
        "pollId": { "type": "string", "description": "ID of the parent poll" }
      },
      "required": ["name", "imageUrl", "pollId"]
    },
    "Vote": {
      "title": "User Vote",
      "description": "A vote cast by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the voter" },
        "username": { "type": "string", "description": "Username of the voter" },
        "pollId": { "type": "string", "description": "ID of the poll" },
        "participantId": { "type": "string", "description": "ID of the voted participant" },
        "craziness": { "type": "number", "description": "Pgllazi score" },
        "madness": { "type": "number", "description": "Zookige score" },
        "foolishness": { "type": "number", "description": "Cxotalge score" },
        "comment": { "type": "string", "description": "Optional comment" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the vote was cast" }
      },
      "required": ["userId", "username", "pollId", "participantId", "craziness", "madness", "foolishness", "timestamp"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/polls/{pollId}": {
      "schema": "Poll",
      "description": "Arena poll documents"
    },
    "/polls/{pollId}/participants/{participantId}": {
      "schema": "Participant",
      "description": "Participants within a poll"
    },
    "/votes/{voteId}": {
      "schema": "Vote",
      "description": "User votes"
    }
  }
}
